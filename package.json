{
  "name": "pixelforge-studio",
  "version": "0.1.0",
  "private": true,
  "description": "PixelForge Studio native Windows desktop image editor",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "desktop:prepare": "node desktop/copy-vendor.cjs && node desktop/make-icon.cjs",
    "build:win": "npm run desktop:prepare && electron-builder --win nsis --x64 --publish never",
    "pack:win": "npm run desktop:prepare && electron-builder --win dir --x64 --publish never",
    "test:gif": "node desktop/test-gif.cjs"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.75.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.12",
    "sharp": "^0.34.4"
  },
  "build": {
    "appId": "com.pixelforge.studio",
    "productName": "PixelForge Studio",
    "asar": true,
    "files": [
      "index.html",
      "cloud-config.js",
      "desktop/main.cjs",
      "desktop/preload.cjs",
      "desktop/vendor/supabase.min.js",
      "package.json",
      "desktop/icon.ico"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "PixelForge-Setup-${version}.${ext}",
      "verifyUpdateCodeSignature": false,
      "icon": "desktop/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PixelForge Studio",
      "perMachine": false,
      "packElevateHelper": false
    },
    "protocols": [
      {
        "name": "PixelForge desktop sign-in",
        "schemes": [
          "pixelforge"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "TheImposter1000",
        "repo": "PixelForge",
        "releaseType": "release"
      }
    ],
    "fileAssociations": [
      {
        "ext": "pforge",
        "name": "PixelForge Studio Project",
        "description": "Editable PixelForge image project",
        "role": "Editor"
      },
      {
        "ext": [
          "png",
          "jpg",
          "jpeg",
          "webp",
          "gif",
          "bmp",
          "avif",
          "svg"
        ],
        "name": "PixelForge Image",
        "description": "Image file",
        "role": "Editor"
      },
      {
        "ext": "psd",
        "name": "Photoshop Document",
        "description": "Layered Photoshop image",
        "role": "Editor"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  }
}
